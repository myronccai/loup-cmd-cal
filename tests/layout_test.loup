@mode(host.dual)

# Unit tests for laying out months (calendar.grid) and drawing them
# (calendar.layout): cell positions, week number columns, centring, the
# usual and the vertical layout, and the reverse-video highlight. Expected
# lines are util-linux cal's output for the same months.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel`, source/ on
# LOUPPATH), one test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from calendar.grid import (MonthGrid, fill_month, BLANK, CELLS, WEEK_LINES);
from calendar.layout import (Style, make_style, center, left_align, render_row, render_vertical_row);
from calendar.names import (month_name, month_from_name, weekday_headings);
from calendar.weeks import (Numbering);

const ESC: string = "\u{1B}";

func plain(julian: bool, first_day: int, numbering: Numbering): Style {
    return make_style(julian, first_day, numbering, 2, false, false, 0, 0, 0, 0);
}

func test_fill_places_the_first_day(): void {
    let grid = fill_month(2026, 10, 0, false, Numbering.Off);
    expectEq(grid.days.len(), CELLS, "six weeks of cells");
    expectEq(grid.days[3], BLANK, "Wednesday before the 1st");
    expectEq(grid.days[4], 1, "October 1, 2026 is a Thursday");
    expectEq(grid.days[34], 31, "the 31st ends the fifth week");
    expectEq(grid.days[35], BLANK, "the sixth week is empty");
    expectEq(grid.weeks[0], BLANK, "no week numbers");
}

func test_fill_with_monday_first(): void {
    let grid = fill_month(2026, 3, 1, false, Numbering.Off);
    expectEq(grid.days[6], 1, "March 1, 2026 is a Sunday: the last column");
    expectEq(grid.days[36], 31, "the 31st is in the sixth week");
}

func test_fill_julian_counts_days_of_the_year(): void {
    let grid = fill_month(2024, 3, 0, true, Numbering.Off);
    expectEq(grid.days[5], 61, "March 1, 2024 is day 61");
}

func test_fill_week_numbers(): void {
    let grid = fill_month(2021, 1, 1, false, Numbering.Iso);
    expectEq(grid.weeks[0], 53, "January 1-3, 2021 are in week 53");
    expectEq(grid.weeks[1], 1, "then week 1");
    expectEq(grid.weeks[4], 4, "the last line with days");
    expectEq(grid.weeks[5], BLANK, "no number for an empty line");
    let december = fill_month(2025, 12, 1, false, Numbering.Iso);
    expectEq(december.weeks[4], 1, "December 29-31, 2025 are in week 1");
}

func test_names(): void {
    expectEq(month_name(9), "September", "month name");
    expectEq(month_from_name("sep") ?? 0, 9, "abbreviation");
    expectEq(month_from_name("SEPTEMBER") ?? 0, 9, "any case");
    expectEq(month_from_name("sept") ?? 0, 0, "other prefixes are not names");
    expectEq(weekday_headings(1, 2), "Mo Tu We Th Fr Sa Su", "Monday first");
    expectEq(weekday_headings(0, 3), "Sun Mon Tue Wed Thu Fri Sat", "-j headings");
}

func test_center_and_left_align(): void {
    expectEq(center("October 2026", 20), "    October 2026    ", "even padding");
    expectEq(center("October 2026", 23), "      October 2026     ", "the odd space goes left");
    expectEq(center("abc", 2), "ab", "cut to the width");
    expectEq(left_align("May", 6), "May   ", "left aligned");
}

func test_render_one_month(): void {
    let grid = fill_month(2026, 10, 0, false, Numbering.Off);
    let lines = render_row([grid], plain(false, 0, Numbering.Off));
    expectEq(lines.len(), 2 + WEEK_LINES, "header, weekdays, six weeks");
    expectEq(lines[0], "    October 2026    ", "header");
    expectEq(lines[1], "Su Mo Tu We Th Fr Sa", "weekdays");
    expectEq(lines[2], "             1  2  3", "first week");
    expectEq(lines[6], "25 26 27 28 29 30 31", "last week");
    expectEq(lines[7], "                    ", "an empty week is spaces");
}

func test_render_week_numbers_and_julian(): void {
    let grid = fill_month(2024, 2, 1, true, Numbering.Iso);
    let lines = render_row([grid], plain(true, 1, Numbering.Iso));
    expectEq(lines[0], "         February 2024        ", "header over 30 columns");
    expectEq(lines[1], "   Mon Tue Wed Thu Fri Sat Sun", "-j weekdays after the number column");
    expectEq(lines[2], " 5              32  33  34  35", "week 5");
    expectEq(lines[6], " 9  57  58  59  60            ", "week 9");
}

func test_render_months_side_by_side(): void {
    let style = plain(false, 0, Numbering.Off);
    let lines = render_row([fill_month(2024, 1, 0, false, Numbering.Off), fill_month(2024, 2, 0, false, Numbering.Off)], style);
    expectEq(lines[0], "    January 2024          February 2024   ", "headers and gutter");
    expectEq(lines[2], "    1  2  3  4  5  6               1  2  3", "first weeks");
}

func test_render_vertical(): void {
    let style = make_style(false, 0, Numbering.Us, 1, false, false, 0, 0, 0, 0);
    let lines = render_vertical_row([fill_month(2026, 10, 0, false, Numbering.Us)], style);
    expectEq(lines.len(), 9, "header, seven weekdays, week numbers");
    expectEq(lines[0], "    October 2026       ", "header, then the gutter");
    expectEq(lines[1], "Su     4 11 18 25   ", "Sundays");
    expectEq(lines[5], "Th  1  8 15 22 29   ", "Thursdays");
    expectEq(lines[8], "   40 41 42 43 44   ", "week numbers");
}

func test_highlight(): void {
    # February 15, 2026 is day 46 of the year.
    let style = make_style(false, 0, Numbering.Off, 2, false, true, 2026, 2, 46, 0);
    let lines = render_row([fill_month(2026, 2, 0, false, Numbering.Off)], style);
    expectEq(lines[4], ESC + "[7m15" + ESC + "[0m 16 17 18 19 20 21", "the 15th in reverse video");
    let other = render_row([fill_month(2026, 3, 0, false, Numbering.Off)], style);
    expect(!other[4].contains(ESC), "no highlight in another month");
}

func test_highlight_week_number(): void {
    let style = make_style(false, 1, Numbering.Iso, 2, false, true, 0, 0, 0, 8);
    let lines = render_row([fill_month(2026, 2, 1, false, Numbering.Iso)], style);
    expectEq(lines[5], ESC + "[7m 8" + ESC + "[0m 16 17 18 19 20 21 22", "week 8 in reverse video");
}
