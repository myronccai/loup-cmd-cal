@mode(host.dual)

# Top level of cal: parse the arguments, report a usage error, handle
# --help and --version, run the command and turn an unexpected exception
# into status 1, the only failure status util-linux cal has.
#
# Runtime: host.dual. Compiled into the native binary build/cal by `make
# build`; `loup-bootstrap run source/main.loup` interprets the same code,
# and the unit tests call run() directly.

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE);
from cli.args import (ArgError, parse_args, try_help_line);
from cli.usage import (usage, version_line);
from commands.cal import (run_cal);

# Parses argv, runs cal and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(e) => {
            return report(e);
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_cal(opts);
    } catch (Exception as e) {
        printErr(APP_NAME + ": " + e.message);
        return EXIT_FAILURE;
    }
}

func report(e: ArgError): int {
    printErr(APP_NAME + ": " + e.message);
    if (e.try_help) {
        printErr(try_help_line());
    }
    return EXIT_FAILURE;
}
