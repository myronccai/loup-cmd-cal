@mode(host.dual)

# cal: entry point. Keep this file thin: all behaviour lives in cli.app.run
# so that tests can call it with an argument list.
#
# Runtime: host.dual. main() gets the command line from runtime.args(). The
# same source runs two ways: `make run` interprets it with `loup-bootstrap
# run source/main.loup` (Stage0), because the self-hosted `loup run` lacks
# execShell, which asks the shell whether standard output is a terminal;
# `make build` compiles it with the rest of source/ into the native binary
# build/cal, which `make e2e` and CI then exercise.

from cli.app import (run);

func main(): int {
    return run(runtime.args());
}
