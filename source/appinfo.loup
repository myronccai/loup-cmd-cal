@mode(host.dual)

# Application identity for cal: name, version, summary and exit statuses.
# Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/cal by `make
# build`; `loup-bootstrap run source/main.loup` interprets the same code.

pub const APP_NAME: string = "cal";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Display a calendar (a Loup recreation of util-linux cal).";

# Exit statuses returned by main(). util-linux cal has only these two: a
# usage error is a failure like any other.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
